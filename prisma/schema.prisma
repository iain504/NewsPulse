generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A stored sentiment analysis of a news article
model Analysis {
  id         String   @id @default(cuid())
  title      String
  source     String?
  content    String
  // positive | negative | neutral | mixed
  sentiment  String
  // -1 .. 1
  score      Float
  // 0 .. 1
  confidence Float
  // JSON arrays / objects serialized as strings
  emotions   String   @default("[]")
  keywords   String   @default("[]")
  entities   String   @default("[]")
  summary    String   @default("")
  reasoning  String   @default("")
  // model used: edge0-35b | edge0-8b
  model      String
  latencyMs  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([sentiment])
}

// One round of the "Guess the sentiment" study game
model QuizRound {
  id          String   @id @default(cuid())
  headline    String
  body        String   @default("")
  userGuess   String   @default("")
  aiSentiment String   @default("")
  explanation String   @default("")
  correct     Boolean  @default(false)
  answered    Boolean  @default(false)
  model       String
  createdAt   DateTime @default(now())
}

// A topic the user wants the live news feed to follow
model FollowedTopic {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// One LLM-generated trade signal computed from Binance bar data
model Signal {
  id          String   @id @default(cuid())
  symbol      String // e.g. BTCUSDT
  interval    String // e.g. 15m
  // BUY | SELL | WAIT
  direction   String
  // 0..1
  confidence  Float
  // last close at analysis time
  price       Float
  entry       Float
  entryLow    Float
  entryHigh   Float
  stopLoss    Float
  takeProfit  Float
  rrRatio     Float
  // scalp | intraday | swing
  timeHorizon String @default("intraday")
  summary     String @default("")
  // JSON arrays
  reasons     String @default("[]")
  risks       String @default("[]")
  // JSON MarketSnapshot of computed indicators
  indicators  String @default("{}")
  // streamed trading-plan prose
  rationale   String @default("")
  model       String
  latencyMs   Int    @default(0)
  // manual | auto
  source      String @default("manual")
  createdAt   DateTime @default(now())

  trade Trade?

  @@index([createdAt])
  @@index([symbol, createdAt])
}

// One simulated (paper) trade opened from a signal — P&L tracked to the cent
model Trade {
  id          String    @id @default(cuid())
  signalId    String?   @unique
  signal      Signal?   @relation(fields: [signalId], references: [id], onDelete: SetNull)
  symbol      String
  // BUY = long, SELL = short
  direction   String
  entryPrice  Float
  stopLoss    Float
  takeProfit  Float
  // coins bought/sold (notional / entryPrice)
  quantity    Float
  // USDT position size at entry
  notional    Float
  // OPEN | CLOSED
  status      String    @default("OPEN")
  exitPrice   Float?
  pnl         Float?
  pnlPct      Float?
  // TP | SL | MANUAL
  exitReason  String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  @@index([status])
  @@index([symbol, openedAt])
}

// A symbol saved in the watchlist; `scan` marks it for the auto-scan loop
model WatchItem {
  id        String   @id @default(cuid())
  symbol    String   @unique
  scan      Boolean  @default(true)
  createdAt DateTime @default(now())
}
